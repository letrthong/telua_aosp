#!/bin/bash
# ==============================================================================
# const_multi_cli.config - Global Multi-Command Pipeline & Macro Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is located in the same directory as 'build_apk.sh' (Master Toolkit).
# Supports executing sequential command pipelines / macros step-by-step.
#
# Usage:
#   telua run                     (display list of available pipeline groups)
#   telua run <group_name>        (execute commands in specified pipeline group)
#   telua multi <group_name>      (alias equivalent to 'run')
#
# (Specific projects can define or override custom groups inside apk.config)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Pipeline Groups Registry (Displayed when running: telua run)
# Syntax per line: "group_name :: Concise English description"
# ------------------------------------------------------------------------------
MULTI_GROUP_LIST=(
    "audio-cycle      :: Restart KitchenSink & test volume keys on AAOS"
    "media-mute-cycle :: Mute media volume group (zone 0, group 1), wait 5s, then unmute"
    "dev-prep         :: Prepare device with adb root, remount & debug log properties"
    "remount-reboot   :: Root, remount partitions and reboot target device"
    "audio-dump       :: Sequentially dump audio framework, car_audio & media sessions"
    "logcat-start     :: Wait for device, clear buffer & record logcat directly to host"
    "logcat-stop      :: Stop background logcat recording on host computer"
    "net-up           :: Bring up network interface (ens33), get IP via DHCP & verify internet"
    "unittest         :: Run master unit test suite for python and shell scripts"
)

# ------------------------------------------------------------------------------
# 2. Command Pipeline Step Definitions
# Syntax: MULTI_CMD_<GROUP_NAME_UPPERCASE>=( "cmd 1" "cmd 2" ... )
# Variable names are dynamically mapped from group_name:
#   e.g.: audio-cycle      -> MULTI_CMD_AUDIO_CYCLE
#         media-mute-cycle -> MULTI_CMD_MEDIA_MUTE_CYCLE
#         dev-prep         -> MULTI_CMD_DEV_PREP
#         remount-reboot   -> MULTI_CMD_REMOUNT_REBOOT
#         audio-dump       -> MULTI_CMD_AUDIO_DUMP
#
# Supports ADB commands, host shell commands, sleep, git, repo, etc.
# If any step fails (exit code != 0), execution aborts immediately (fail-fast).
# ------------------------------------------------------------------------------

# Group 1: audio-cycle (Lifecycle restart & volume key injection on AAOS)
MULTI_CMD_AUDIO_CYCLE=(
    "adb shell am force-stop com.google.android.car.kitchensink"
    "sleep 1"
    "adb shell am start com.google.android.car.kitchensink/.KitchenSinkActivity"
    "sleep 2"
    "adb shell dumpsys car_service inject-key 24"
    "sleep 1"
    "adb shell dumpsys car_service inject-key 25"
)

# Group 2: media-mute-cycle (Mute media group zone 0 group 1, wait 5s, unmute)
MULTI_CMD_MEDIA_MUTE_CYCLE=(
    "adb shell dumpsys car_service set-mute-car-volume-group 0 1 mute"
    "sleep 5"
    "adb shell dumpsys car_service set-mute-car-volume-group 0 1 unmute"
)

# Group 3: dev-prep (Acquire root, remount filesystem & enable CarAudio debug logs)
MULTI_CMD_DEV_PREP=(
    "adb root"
    "adb remount"
    "adb shell setprop persist.log.tag.CarAudioService DEBUG"
    "adb shell setprop persist.log.tag.CarZones DEBUG"
    "adb shell setprop persist.log.tag.AudioControlHal DEBUG"
)

# Group 4: remount-reboot (Root, remount system partitions and reboot device)
MULTI_CMD_REMOUNT_REBOOT=(
    "adb wait-for-device"
    "adb root"
    "adb remount"
    "adb reboot"
)

# Group 5: audio-dump (Comprehensive audio diagnostic collection across services)
MULTI_CMD_AUDIO_DUMP=(
    "adb shell dumpsys audio"
    "adb shell dumpsys car_audio"
    "adb shell dumpsys media_session"
)

# Group 6: logcat-start (Wait for device, clear buffer & record logcat directly to host file)
MULTI_CMD_LOGCAT_START=(
    "adb wait-for-device"
    "[ -f .logcat.pid ] && kill \$(cat .logcat.pid) 2>/dev/null && rm -f .logcat.pid || true"
    "adb logcat -c"
    "nohup adb logcat -v threadtime > device_logcat.log 2>&1 & echo \$! > .logcat.pid"
)

# Group 7: logcat-stop (Stop background logcat recording on host)
MULTI_CMD_LOGCAT_STOP=(
    "[ -f .logcat.pid ] && kill \$(cat .logcat.pid) 2>/dev/null && rm -f .logcat.pid || pkill -f \"adb logcat\" || true"
    "test -f device_logcat.log && ls -lh device_logcat.log || true"
)

# Group 8: net-up (Restore host network on interface ens33: up -> DHCP -> verify -> ping test)
MULTI_CMD_NET_UP=(
    "sudo ip link set ens33 up"
    "sudo dhclient ens33"
    "ip a show ens33"
    "ping -c 4 -w 10 8.8.8.8"
)

# Group 9: unittest (Master test suite for python & shell scripts)
MULTI_CMD_UNITTEST=(
    "cd tests && ./run_unittest_test.sh"
)