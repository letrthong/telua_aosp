#!/bin/bash
# ==============================================================================
# apk_overlays.config.example - Template for Personal & Private Project Overrides
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This template is provided for developers to configure private, local overrides.
# 'telua init' copies this file to 'apk_overlays.config' if it does not exist yet.
#
# ⚠️ CONFIDENTIALITY NOTICE:
# The resulting 'apk_overlays.config' is excluded by .gitignore so your private
# project paths, custom credentials, and confidential profiles are NEVER committed
# or shared to Git. It is also safely backed up and restored during 'telua update'.
#
# After 'telua init' copies or decrypts apk.config, each KEY=value is applied:
#   - Top-level keys in apk.config are replaced in place.
#   - Case branches (e.g. "oem_service") in case "$ACTIVE_PROJECT" are merged
#     per-branch; custom branches are inserted before the default '*)' branch.
#   - Unmatched keys/blocks are appended at the end of apk.config.
#
# Test without writing: python3 config_overlay.py ./apk.config --dry-run
# ==============================================================================

ACTIVE_PROJECT="oem_service"
case "$ACTIVE_PROJECT" in
    "oem_service")
        MODULE_NAME="OemService"
        SOURCE_CODE_RELATIVE_PATH="packages/apps/Car/OemService"
        APK_OUTPUT_RELATIVE_PATH="out/target/product/qssi/system/priv-app/OemService"
        APK_FILE_NAME="OemService.apk"
        APK_DEPLOY_PATH="/system/priv-app/OemService"
        DEFAULT_LOGCAT_FILTER="OemService"
        DEFAULT_DEBUG_LOG_TAGS="OemService"
        ;;

     
esac

