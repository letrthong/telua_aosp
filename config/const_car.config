#!/bin/bash
# ==============================================================================
# const_audio.config - Global Audio & ADB Shell Commands Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is located in the same directory as 'build_apk.sh' (Master Toolkit).
# Default Audio ADB commands are shared across all workspaces and projects.
# (If a specific project requires custom overrides, define them in apk.config)
#
# Supported default actions: vol-up | vol-down | vol-mute | ks | ks-stop
# All commands are executed directly on target device via 'adb shell <COMMAND>'.
# Compatible with standard Android and Android Automotive (CarShellCommand):
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/service/src/com/android/car/CarShellCommand.java
# ==============================================================================

# Volume Up action (invoked by: telua audio vol-up | telua --audio vol-up)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 24" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj raise"
#   - Hardware keyevent:               "input keyevent 24"
ADB_SHELL_AUDIO_UP="dumpsys car_service inject-key 24"

# Volume Down action (invoked by: telua audio vol-down | telua --audio vol-down)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 25" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj lower"
#   - Hardware keyevent:               "input keyevent 25"
ADB_SHELL_AUDIO_DOWN="dumpsys car_service inject-key 25"

# Volume Mute action (invoked by: telua audio vol-mute | telua --audio vol-mute)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 164" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj mute"
#   - CarShellCommand (AAOS):          "cmd car_service set-audio-muted 0 0 true"
ADB_SHELL_AUDIO_MUTE="dumpsys car_service inject-key 164"


# ------------------------------------------------------------------------------
# Kitchen Sink App Control (AAOS Test Harness)
# Start: launch KitchenSinkActivity | Stop: force-stop by package name
# (kill by PID fails: app runs under its own UID, shell has no permission)
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/tests/EmbeddedKitchenSinkApp/
# ------------------------------------------------------------------------------
ADB_SHELL_AUDIO_KS_START="am start com.google.android.car.kitchensink/.KitchenSinkActivity"
ADB_SHELL_AUDIO_KS_STOP="am force-stop com.google.android.car.kitchensink"

# ------------------------------------------------------------------------------
# Audio CLI Command List (Displayed when running: telua audio)
# Syntax per line: "action :: English description :: adb_shell_command"
# Add or remove rows in this array to customize supported CLI actions:
# ------------------------------------------------------------------------------
AUDIO_CLI_LIST=(
    "vol-up   :: Volume Up (AAOS inject-key 24)        :: $ADB_SHELL_AUDIO_UP"
    "vol-down :: Volume Down (AAOS inject-key 25)      :: $ADB_SHELL_AUDIO_DOWN"
    "vol-mute :: Volume Mute (AAOS inject-key 164)     :: $ADB_SHELL_AUDIO_MUTE"
    "ks       :: Start Kitchen Sink test app           :: $ADB_SHELL_AUDIO_KS_START"
    "ks-stop  :: Stop Kitchen Sink test app            :: $ADB_SHELL_AUDIO_KS_STOP"
)
