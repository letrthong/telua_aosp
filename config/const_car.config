#!/bin/bash
# ==============================================================================
# const_car.config - Global Car (AAOS) Control & ADB Shell Commands Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is located in the same directory as 'build_apk.sh' (Master Toolkit).
# Default Car ADB commands are shared across all workspaces and projects.
# (If a specific project requires custom overrides, define them in apk.config)
#
# Supported default actions: vol-up | vol-down | vol-mute | ks | ks-stop | car-status
# All commands are executed directly on target device via 'adb shell <COMMAND>'.
# Compatible with standard Android and Android Automotive (CarShellCommand):
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/service/src/com/android/car/CarShellCommand.java
#
# NOTE: Renamed from const_audio.config - 'telua audio' is now 'telua car'.
# ==============================================================================

# Volume Up action (invoked by: telua car vol-up | telua --car vol-up)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 24" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj raise"
#   - Hardware keyevent:               "input keyevent 24"
ADB_SHELL_CAR_UP="dumpsys car_service inject-key 24"

# Volume Down action (invoked by: telua car vol-down | telua --car vol-down)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 25" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj lower"
#   - Hardware keyevent:               "input keyevent 25"
ADB_SHELL_CAR_DOWN="dumpsys car_service inject-key 25"

# Volume Mute action (invoked by: telua car vol-mute | telua --car vol-mute)
# Options:
#   - AAOS CarInputService inject-key: "dumpsys car_service inject-key 164" (Recommended)
#   - Standard media volume:           "cmd media_session volume --show --adj mute"
#   - CarShellCommand (AAOS):          "cmd car_service set-audio-muted 0 0 true"
ADB_SHELL_CAR_MUTE="dumpsys car_service inject-key 164"


# ------------------------------------------------------------------------------
# Kitchen Sink App Control (AAOS Test Harness)
# Start: launch KitchenSinkActivity | Stop: force-stop by package name
# (kill by PID fails: app runs under its own UID, shell has no permission)
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/tests/EmbeddedKitchenSinkApp/
# ------------------------------------------------------------------------------
ADB_SHELL_CAR_KS_START="am start com.google.android.car.kitchensink/.KitchenSinkActivity"
ADB_SHELL_CAR_KS_STOP="am force-stop com.google.android.car.kitchensink"

# Car Service status action (invoked by: telua car status)
# Lists all services registered inside CarService (CarShellCommand --list).
# NOTE: 'cmd car_service car_status' is NOT supported on Android 16 QSSI builds,
# so use 'dumpsys car_service --list' instead.
ADB_SHELL_CAR_STATUS="dumpsys car_service --list"

# ------------------------------------------------------------------------------
# Car CLI Command List (Displayed when running: telua car)
# Syntax per line: "action :: English description :: adb_shell_command"
# Add or remove rows in this array to customize supported CLI actions:
# ------------------------------------------------------------------------------
CAR_CLI_LIST=(
    "vol-up   :: Volume Up (AAOS inject-key 24)        :: $ADB_SHELL_CAR_UP"
    "vol-down :: Volume Down (AAOS inject-key 25)      :: $ADB_SHELL_CAR_DOWN"
    "vol-mute :: Volume Mute (AAOS inject-key 164)     :: $ADB_SHELL_CAR_MUTE"
    "ks       :: Start Kitchen Sink test app           :: $ADB_SHELL_CAR_KS_START"
    "ks-stop  :: Stop Kitchen Sink test app            :: $ADB_SHELL_CAR_KS_STOP"
    "status   :: List all CarService services (dumpsys --list) :: $ADB_SHELL_CAR_STATUS"
)

