#!/bin/bash
# ==============================================================================
# const_system_cli.config - System & Host Info CLI Pipelines for Telua Toolkit
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# Usage:
#   telua system                 (display list of available System CLI actions)
#   telua system <action_name>   (execute commands in specified System action)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System CLI Registry (Displayed when running: telua system)
# Syntax per line: "action_name :: Concise description"
# ------------------------------------------------------------------------------
SYSTEM_GROUP_LIST=(
    "ram             :: Show system RAM and Swap memory usage (free -h)"
    "os              :: Show operating system release, kernel version, and CPU info"
    "docker-status   :: Check Docker daemon service status and containers"
)

# ------------------------------------------------------------------------------
# 2. System Command Pipeline Step Definitions
# Syntax: SYSTEM_CMD_<ACTION_NAME_UPPERCASE>=( "cmd 1" "cmd 2" ... )
# ------------------------------------------------------------------------------

# 1. ram: Show system RAM & Swap capacity
SYSTEM_CMD_RAM=(
    "free -h"
)

# 2. os: Show operating system & kernel info
SYSTEM_CMD_OS=(
    "cat /etc/os-release"
    "uname -a"
    "uptime"
)

# 3. docker-status: Check Docker daemon service status & containers
SYSTEM_CMD_DOCKER_STATUS=(
    "systemctl status docker --no-pager || service docker status || true"
    "docker ps -a"
)
