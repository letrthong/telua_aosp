#!/bin/bash
# ==============================================================================
# const_system_cli.config - Executable System & Docker CLI Pipelines
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# Usage:
#   telua system                 (display list of available System/Docker CLI actions)
#   telua system <action_name>   (execute commands in specified action)
#   telua docker <action_name>   (alias for telua system <action_name>)
#   telua --docker-help          (print full const_docker.config cheatsheet)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. System / Docker CLI Registry (Displayed when running: telua system)
# Syntax per line: "action_name :: Concise description"
# ------------------------------------------------------------------------------
SYSTEM_GROUP_LIST=(
    "status          :: Check Docker daemon service status and containers"
    "ps              :: List all Docker containers (running and stopped)"
    "images          :: List all local Docker images"
    "df              :: Show Docker disk usage summary (docker system df)"
    "start           :: Start Docker daemon service (systemctl start docker)"
    "stop            :: Stop Docker daemon service (systemctl stop docker)"
    "restart         :: Restart Docker daemon service (systemctl restart docker)"
    "logs            :: View last 50 lines of Docker daemon service logs (journalctl)"
    "prune           :: Remove stopped containers and dangling images (docker system prune -f)"
)

# ------------------------------------------------------------------------------
# 2. System / Docker Command Pipeline Step Definitions
# Syntax: SYSTEM_CMD_<ACTION_NAME_UPPERCASE>=( "cmd 1" "cmd 2" ... )
# ------------------------------------------------------------------------------

# 1. status: Check Docker daemon service status & active containers
SYSTEM_CMD_STATUS=(
    "systemctl status docker --no-pager || service docker status || true"
    "docker ps -a"
)

# 2. ps: List all containers
SYSTEM_CMD_PS=(
    "docker ps -a"
)

# 3. images: List downloaded/built images
SYSTEM_CMD_IMAGES=(
    "docker images"
)

# 4. df: Docker disk usage
SYSTEM_CMD_DF=(
    "docker system df"
)

# 5. start: Start Docker service
SYSTEM_CMD_START=(
    "sudo systemctl start docker"
    "systemctl is-active docker"
)

# 6. stop: Stop Docker service
SYSTEM_CMD_STOP=(
    "sudo systemctl stop docker"
)

# 7. restart: Restart Docker service
SYSTEM_CMD_RESTART=(
    "sudo systemctl restart docker"
    "systemctl is-active docker"
)

# 8. logs: View recent Docker service logs
SYSTEM_CMD_LOGS=(
    "sudo journalctl -u docker -n 50 --no-pager"
)

# 9. prune: Clean up unused Docker resources
SYSTEM_CMD_PRUNE=(
    "docker system prune -f"
)

