# ==============================================================================
# const_dumpsys.config - Global Dumpsys & Diagnostics Commands Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is located in the same directory as 'build_apk.sh' (Master Toolkit).
# Diagnostic dumpsys commands are shared across all workspaces and projects.
# (If a specific project requires custom overrides, define them in apk.config)
#
# Usage: telua dump <target>   (e.g., telua dump audio | telua dump car-service)
# All commands are executed directly on target device via 'adb shell <COMMAND>'.
# Compatible with standard Android and Android Automotive (CarShellCommand):
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/service/src/com/android/car/CarShellCommand.java
# ==============================================================================

# Dump targets (invoked by: telua dump <target> | telua --dump <target>)
# Options:
#   - Standard Android Audio:  "dumpsys audio"
#   - CarService (AAOS):       "dumpsys car_service"
#   - CarAudioService (AAOS):  "dumpsys car_audio"
#   - MediaSession:            "dumpsys media_session"
#   - Battery status:          "dumpsys battery"
#   - Top Activity stack:      "dumpsys activity top"
ADB_SHELL_DUMP_AUDIO="dumpsys audio"
ADB_SHELL_DUMP_CAR_SERVICE="dumpsys car_service"
ADB_SHELL_DUMP_CAR_AUDIO="dumpsys car_audio"
ADB_SHELL_DUMP_MEDIA_SESSION="dumpsys media_session"
ADB_SHELL_DUMP_BATTERY="dumpsys battery"
ADB_SHELL_DUMP_ACTIVITY="dumpsys activity top"

# ------------------------------------------------------------------------------
# Dump CLI Command List (Displayed when running: telua dump)
# Syntax per line: "target :: English description :: adb_shell_command"
# Add or remove rows in this array to customize supported diagnostic targets:
# ------------------------------------------------------------------------------
DUMP_CLI_LIST=(
    "audio        :: Audio service state (standard Android)  :: $ADB_SHELL_DUMP_AUDIO"
    "car-service  :: CarService state (AAOS shell command)   :: $ADB_SHELL_DUMP_CAR_SERVICE"
    "car-audio    :: CarAudioService dumpsys (AAOS)          :: $ADB_SHELL_DUMP_CAR_AUDIO"
    "media        :: Media session active playback state     :: $ADB_SHELL_DUMP_MEDIA_SESSION"
    "battery      :: Battery charging & power levels         :: $ADB_SHELL_DUMP_BATTERY"
    "activity     :: Top foreground Activity & window stack  :: $ADB_SHELL_DUMP_ACTIVITY"
)
