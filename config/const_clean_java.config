# ==============================================================================
# const_clean_java.config - Java Whitespace Cleaner Settings (clean_java.py)
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is read automatically by python/clean_java.py (telua clean-java).
# Format: bash-style KEY="VALUE" lines; lines starting with '#' are comments.
# The file is OPTIONAL: a missing file or missing key falls back to the
# built-in defaults hardcoded in clean_java.py.
# ==============================================================================

# ------------------------------------------------------------------------------
# ENSURE_TRAILING_NEWLINE - should the file end with exactly one newline?
#   1 = (recommended, POSIX convention) trim trailing blank lines and append
#       a final newline when missing, so the file ends with "...}\n".
#       Git then no longer shows "\ No newline at end of file" and diff/patch
#       tools, compilers and linters behave consistently.
#   0 = keep the end of the file as-is: no final newline is added and
#       existing trailing blank lines are preserved.
# ------------------------------------------------------------------------------
ENSURE_TRAILING_NEWLINE="0"

# ------------------------------------------------------------------------------
# TAB_WIDTH - number of spaces used to expand one leading tab (indentation).
# ------------------------------------------------------------------------------
TAB_WIDTH="4"

# ------------------------------------------------------------------------------
# FIX_KEYWORD_PAREN_SPACING - normalize control-flow header spacing:
#   if(x) -> if (x)   and   if ( x ) -> if (x)   (1 = enable, 0 = disable)
# ------------------------------------------------------------------------------
FIX_KEYWORD_PAREN_SPACING="1"

# ------------------------------------------------------------------------------
# COLLAPSE_BLANK_LINES - collapse runs of 2+ consecutive blank lines into a
# single blank line (1 = enable, 0 = disable).
# ------------------------------------------------------------------------------
COLLAPSE_BLANK_LINES="1"

# ------------------------------------------------------------------------------
# ENABLE_GOOGLE_JAVA_FORMAT - run google-java-format check in section [4] of
# 'telua clean-java report' (1 = enable, 0 = disable).
# If google-java-format is not found locally, 'telua clean-java report' clones
# GOOGLE_JAVA_FORMAT_REPO_URL into ~/google-java-format-pre-commit.
# ------------------------------------------------------------------------------
ENABLE_GOOGLE_JAVA_FORMAT="1"

# ------------------------------------------------------------------------------
# GOOGLE_JAVA_FORMAT_AOSP - use AOSP 4-space indentation style (--aosp) when
# invoking google-java-format (1 = AOSP 4-space style, 0 = Google 2-space).
# ------------------------------------------------------------------------------
GOOGLE_JAVA_FORMAT_AOSP="1"

# ------------------------------------------------------------------------------
# GOOGLE_JAVA_FORMAT_REPO_URL - repository cloned into
# ~/google-java-format-pre-commit when google-java-format is not yet installed.
# ------------------------------------------------------------------------------
GOOGLE_JAVA_FORMAT_REPO_URL="https://github.com/maciejwalkowiak/google-java-format-pre-commit"
