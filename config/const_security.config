#!/bin/bash
# ==============================================================================
# const_security.config - Global Security, SELinux & Diagnostics Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# This file is located in the config/ directory of the master toolkit.
# Security commands are shared across all workspaces and projects.
# (If a specific project requires custom overrides, define them in apk.config)
#
# Usage: telua sec <action>   (e.g., telua sec status | telua sec perm | telua sec avc)
# Alias: telua security <action>
# ==============================================================================

# Status: Inspect overall security state (SELinux mode, build flavor, secure/debuggable flags)
ADB_SHELL_SEC_STATUS="echo '=== SELinux Mode ===' && getenforce && echo '=== Security Properties ===' && getprop | grep -E 'ro\.(build\.type|debuggable|secure)' && echo '=== dm-verity State ===' && getprop partition.system.verified"

# SELinux control
ADB_SHELL_SEC_PERMISSIVE="setenforce 0 && echo \"SELinux mode set to: \$(getenforce)\""
ADB_SHELL_SEC_ENFORCING="setenforce 1 && echo \"SELinux mode set to: \$(getenforce)\""

# SELinux AVC Audit logs
ADB_SHELL_SEC_AVC="logcat -d -b all 2>/dev/null | grep -i 'avc:' || dmesg 2>/dev/null | grep -i 'avc:' || echo 'No AVC denials found in logcat/dmesg.'"

# Privileged App permissions and whitelist violations
ADB_SHELL_SEC_PRIVAPP="dumpsys package --privapp-permissions 2>/dev/null || cmd package dump-privapp-permissions"

# AppOps permissions & restriction queries
ADB_SHELL_SEC_APPOPS="cmd appops query-op --user 0 2>/dev/null || dumpsys appops"

# Keystore / Keymaster / Keymint status
ADB_SHELL_SEC_KEYSTORE="dumpsys keystore"

# Device Policy Manager / Admin policies
ADB_SHELL_SEC_POLICY="dumpsys device_policy"

# Host-level ADB security commands
ADB_SEC_ROOT="adb root"
ADB_SEC_UNROOT="adb unroot"
ADB_SEC_REMOUNT="adb remount"
ADB_SEC_DISABLE_VERITY="adb disable-verity"
ADB_SEC_ENABLE_VERITY="adb enable-verity"

# ------------------------------------------------------------------------------
# Security CLI Command List (Displayed when running: telua sec)
# Syntax per line: "action :: English description :: command"
# ------------------------------------------------------------------------------
SECURITY_CLI_LIST=(
    "status         :: Overall security state (SELinux, props, verity) :: $ADB_SHELL_SEC_STATUS"
    "perm           :: Set SELinux to Permissive (setenforce 0)         :: $ADB_SHELL_SEC_PERMISSIVE"
    "enforce        :: Set SELinux to Enforcing (setenforce 1)          :: $ADB_SHELL_SEC_ENFORCING"
    "avc            :: Dump SELinux AVC denials from logcat & dmesg     :: $ADB_SHELL_SEC_AVC"
    "privapp        :: Dump priv-app permissions & whitelist state      :: $ADB_SHELL_SEC_PRIVAPP"
    "appops         :: Query AppOps restrictions and granted ops        :: $ADB_SHELL_SEC_APPOPS"
    "keystore       :: Dump Android Keystore service status             :: $ADB_SHELL_SEC_KEYSTORE"
    "policy         :: Dump DevicePolicyManager (DPM) state             :: $ADB_SHELL_SEC_POLICY"
    "root           :: Restart adbd daemon with root privileges         :: $ADB_SEC_ROOT"
    "unroot         :: Restart adbd daemon unrooted (production mode)   :: $ADB_SEC_UNROOT"
    "remount        :: Remount system partitions as read-write          :: $ADB_SEC_REMOUNT"
    "disable-verity :: Disable dm-verity partition verification         :: $ADB_SEC_DISABLE_VERITY"
)
