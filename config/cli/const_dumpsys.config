#!/bin/bash
# ==============================================================================
# const_dumpsys.config - Global Dumpsys & Diagnostics Multi-CLI Pipeline Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# Diagnostic dumpsys commands are shared across all workspaces and projects.
# Supports executing sequential diagnostic commands and filters step-by-step.
#
# Usage:
#   telua dump                     (display list of available diagnostic targets)
#   telua dump <target>            (execute sequential commands for target)
#
# (Specific projects can define or override custom targets in apk.config)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Dumpsys Diagnostics Pipeline Registry (Displayed when running: telua dump)
# Syntax per line: "target :: Concise English description"
# ------------------------------------------------------------------------------
DUMP_GROUP_LIST=(
    "audio              :: Audio service state (standard Android)"
    "car-service        :: CarAudioService full dump (AAOS)"
    "car-audio          :: CarAudio zones/volume groups/gains (AAOS)"
    "focus-enforcement  :: CarAudioFocusEnforcement state (AAOS)"
    "media              :: Media session active playback state"
    "battery            :: Battery charging & power levels"
    "activity           :: Top foreground Activity & window stack"
    "audio-all          :: Comprehensive audio diagnostic collection across services"
)

# ------------------------------------------------------------------------------
# 2. Sequential Command Definitions for Dump Targets
# Syntax: DUMP_CMD_<TARGET_UPPERCASE>=( "cmd 1" "cmd 2" ... )
# Variable names are dynamically mapped from target name:
#   e.g.: audio             -> DUMP_CMD_AUDIO
#         car-service       -> DUMP_CMD_CAR_SERVICE
#         car-audio         -> DUMP_CMD_CAR_AUDIO
#         focus-enforcement -> DUMP_CMD_FOCUS_ENFORCEMENT
#         media             -> DUMP_CMD_MEDIA
#         battery           -> DUMP_CMD_BATTERY
#         activity          -> DUMP_CMD_ACTIVITY
#         audio-all         -> DUMP_CMD_AUDIO_ALL
# ------------------------------------------------------------------------------

# Target 1: audio (Standard Android AudioService dump)
DUMP_CMD_AUDIO=(
    "adb shell dumpsys audio"
)

# Target 2: car-service (AAOS CarAudioService full dump)
DUMP_CMD_CAR_SERVICE=(
    "adb shell dumpsys car_service --services CarAudioService"
)

# Target 3: car-audio (AAOS CarAudio zones, volume groups, gains, and index)
DUMP_CMD_CAR_AUDIO=(
    "adb shell dumpsys car_service --services CarAudioService | grep -E 'CarAudioZone|CarVolumeGroup|Gain|Index'"
)

# Target 4: focus-enforcement (AAOS CarAudioFocusEnforcement state & holders)
DUMP_CMD_FOCUS_ENFORCEMENT=(
    "adb shell dumpsys car_service --services CarAudioService | grep -E 'CarAudioFocusEnforcement|Relaxed focus|Forced enable|Enforceable|Do not silence|Silenced|Focus holders'"
)

# Target 5: media (MediaSession active playback state)
DUMP_CMD_MEDIA=(
    "adb shell dumpsys media_session"
)

# Target 6: battery (Battery status, level & charging info)
DUMP_CMD_BATTERY=(
    "adb shell dumpsys battery"
)

# Target 7: activity (Top foreground Activity & window stack)
DUMP_CMD_ACTIVITY=(
    "adb shell dumpsys activity top"
)

# Target 8: audio-all (Multi-step pipeline: Android Audio + AAOS CarAudio + MediaSession)
DUMP_CMD_AUDIO_ALL=(
    "adb shell dumpsys audio"
    "adb shell dumpsys car_service --services CarAudioService"
    "adb shell dumpsys media_session"
)
