#!/bin/bash
# ==============================================================================
# const_audio.config - Global Audio & ADB Shell Commands Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# File nay dat co dinh cung thu muc voi 'build_apk.sh' (Master Toolkit).
# Cac cau lenh Audio ADB mac dinh duoc chia se cho tat ca cac workspace/du an.
# (Neu mot du an cu the can override bat ky lenh nao, co the khai bao lai trong apk.config)
#
# Supported default actions: vol-up | vol-down | vol-mute | d (dump)
# Tat ca cac lenh duoc thuc thi truc tiep tren thiet bi qua 'adb shell <COMMAND>'.
# Compatible with standard Android and Android Automotive (CarShellCommand):
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/service/src/com/android/car/CarShellCommand.java
# ==============================================================================

# Volume Up action (read by: telua audio vol-up | telua --audio vol-up)
# Options:
#   - Standard media volume: "cmd media_session volume --show --adj raise"
#   - Hardware keyevent:     "input keyevent 24"
ADB_SHELL_AUDIO_UP="cmd media_session volume --show --adj raise"

# Volume Down action (read by: telua audio vol-down | telua --audio vol-down)
# Options:
#   - Standard media volume: "cmd media_session volume --show --adj lower"
#   - Hardware keyevent:     "input keyevent 25"
ADB_SHELL_AUDIO_DOWN="cmd media_session volume --show --adj lower"

# Volume Mute action (read by: telua audio vol-mute | telua --audio vol-mute)
# Options:
#   - Standard media volume: "cmd media_session volume --show --adj mute"
#   - Hardware keyevent:     "input keyevent 164"
#   - CarShellCommand (AAOS): "cmd car_service set-audio-muted 0 0 true"
ADB_SHELL_AUDIO_MUTE="cmd media_session volume --show --adj mute"

# Audio Dump action (read by: telua audio dump | telua audio d | telua --audio dump)
# Options:
#   - Standard Android:       "dumpsys audio"
#   - CarAudioService (AAOS): "dumpsys car_service --services CarAudioService"
#   - Car Audio dumpsys:      "dumpsys car_audio"
ADB_SHELL_AUDIO_DUMP="dumpsys audio"
ADB_SHELL_AUDIO_D="${ADB_SHELL_AUDIO_D:-$ADB_SHELL_AUDIO_DUMP}"

# ------------------------------------------------------------------------------
# Kitchen Sink app control (AAOS test app)
# Start: launch KitchenSinkActivity | Stop: kill process by name (pgrep)
# ------------------------------------------------------------------------------
ADB_SHELL_AUDIO_KS_START="am start com.google.android.car.kitchensink/.KitchenSinkActivity"
ADB_SHELL_AUDIO_KS_STOP="kill \$(pgrep -f kitchensink)"

# ------------------------------------------------------------------------------
# Audio CLI Command List (Hien thi danh sach khi go: telua audio)
# Cu phap moi dong: "action :: mo ta :: cau_lenh_adb"
# Them hoac bot cac dong trong mang nay de ho tro cac lenh CLI theo nhu cau he thong:
# ------------------------------------------------------------------------------
AUDIO_CLI_LIST=(
    "vol-up   :: Volume Up                             :: $ADB_SHELL_AUDIO_UP"
    "vol-down :: Volume Down                           :: $ADB_SHELL_AUDIO_DOWN"
    "vol-mute :: Volume Mute                           :: $ADB_SHELL_AUDIO_MUTE"
    "dump     :: Dump Audio / CarAudio status          :: $ADB_SHELL_AUDIO_DUMP"
    "ks       :: Start Kitchen Sink app                :: $ADB_SHELL_AUDIO_KS_START"
    "ks-stop  :: Stop Kitchen Sink app                 :: $ADB_SHELL_AUDIO_KS_STOP"
)
