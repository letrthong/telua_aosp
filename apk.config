# Configuration file for build_apk.sh (telua AOSP & Automotive Toolkit)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Project Selection
# Set the active project to build and deploy:
# Options: "oem_service" | "car_audio" | "vehicle_service"
# ------------------------------------------------------------------------------
ACTIVE_PROJECT="oem_service"

# Define project profiles (source path, output directory, APK name, deploy path)
case "$ACTIVE_PROJECT" in
    "oem_service")
        MODULE_NAME="OemService"
        SOURCE_CODE_RELATIVE_PATH="packages/apps/Car/OemService"
        APK_OUTPUT_RELATIVE_PATH="out/target/product/qssi/system/priv-app/OemService"
        APK_FILE_NAME="OemService.apk"
        APK_DEPLOY_PATH="/system/priv-app/OemService"
        DEFAULT_LOGCAT_FILTER="OemService"
        DEFAULT_DEBUG_LOG_TAGS="OemService"
        ;;

    "car_audio")
        MODULE_NAME="CarAudioService"
        SOURCE_CODE_RELATIVE_PATH="packages/services/Car/CarAudioService"
        APK_OUTPUT_RELATIVE_PATH="out/target/product/qssi/system/priv-app/CarAudioService"
        APK_FILE_NAME="CarAudioService.apk"
        APK_DEPLOY_PATH="/system/priv-app/CarAudioService"
        DEFAULT_LOGCAT_FILTER="AUDIO|CarAudio"
        DEFAULT_DEBUG_LOG_TAGS="CarAudioService CarZones AudioControlHal"
        ;;

    "vehicle_service")
        MODULE_NAME="VehicleService"
        SOURCE_CODE_RELATIVE_PATH="packages/apps/Car/VehicleService"
        APK_OUTPUT_RELATIVE_PATH="out/target/product/qssi/system/priv-app/VehicleService"
        APK_FILE_NAME="VehicleService.apk"
        APK_DEPLOY_PATH="/system/priv-app/VehicleService"
        DEFAULT_LOGCAT_FILTER="VehicleService"
        DEFAULT_DEBUG_LOG_TAGS="VehicleService"
        ;;

    *)
        echo "ERROR: Unknown ACTIVE_PROJECT '$ACTIVE_PROJECT'!"
        echo "Supported options: 'oem_service' | 'car_audio' | 'vehicle_service'"
        exit 1
        ;;
esac


# ------------------------------------------------------------------------------
# 1b. Softlink Target Workspace (Optional)
# If configured, running './build_apk.sh --softlink' (without arguments) will
# automatically link the script and copy this config to SOFTLINK_TARGET_PATH.
# - If the target folder does not exist but its parent does, it is created automatically.
# - The path MUST reside inside an AOSP tree (containing an 'android/' ancestor).
# Example: SOFTLINK_TARGET_PATH="/home/user/workspace_b/android/qssi/tools"
# ------------------------------------------------------------------------------
SOFTLINK_TARGET_PATH=""


# ------------------------------------------------------------------------------
# 2. Android AOSP Target Environment Configuration
# Target used for lunch command: ${CONFIG_TARGET_PRODUCT}-${CONFIG_TARGET_BUILD_VARIANT}
# ------------------------------------------------------------------------------

# Target deployment platform: "android" | "qnx"
# - "android": Deploy to Android/AOSP device via ADB (default, fully supported)
# - "qnx":     Deploy to QNX Hypervisor environment (currently reserved/not yet supported)
TARGET_PLATFORM="android"

# Relative path to AOSP top build directory from ROOT_DIR.
# - Qualcomm QSSI:                 "android/qssi"
# - MediaTek / NXP / AOSP thuần:   "android"
# Leave empty ("") to auto-detect: prefers android/qssi if present, otherwise android
AOSP_TOP_REL_PATH="android/qssi"

# Android build target product (e.g. from: lunch abc_xyz_in-userdebug)
CONFIG_TARGET_PRODUCT="abc_xyz_in"

# Android build variant (e.g. userdebug, eng, debug)
CONFIG_TARGET_BUILD_VARIANT="xyzdebug"

# Names of environment variables exported by lunch/envsetup to verify active build environment.
# Default AOSP: "TARGET_PRODUCT" and "TARGET_BUILD_VARIANT".
# Customize if your vendor/BSP uses different variable names (e.g. PRODUCT, VARIANT, etc.)
ENV_VAR_PRODUCT_NAME="TARGET_PRODUCT"
ENV_VAR_VARIANT_NAME="TARGET_BUILD_VARIANT"

# Number of parallel build jobs for compiling the APK module (e.g. BUILD_JOBS="8").
# Leave empty ("") to auto-detect CPU cores (nproc)
BUILD_JOBS=""


# ------------------------------------------------------------------------------
# 3. Repo Sync & Multi-Repository Automation (Optional)
# Used when running with: --repo-sync, --repo-sync-only, --repo-reset
# All repo-related variables are prefixed with REPO_ to distinguish from module build.
# ------------------------------------------------------------------------------

# Number of parallel jobs for repo sync. Default: "4" (or leave empty to auto-detect)
REPO_SYNC_JOBS="4"

# Flags passed to 'repo sync'
# Recommended clean flags: "-d -c --force-sync --no-clone-bundle --tags"
REPO_SYNC_FLAGS="-d -c --force-sync --no-clone-bundle --tags"

# Hard reset and clean all git repositories before sync ("true" | "false")
# WARNING: Runs 'repo forall -c "git reset --hard && git clean -xdf"'.
# All uncommitted changes will be permanently discarded.
# Can also be enabled via CLI: --repo-reset
REPO_ENABLE_RESET="false"

# 1. Command executed in ROOT_DIR right after repo sync (BEFORE entering android/qssi)
# Leave empty ("") to define custom CLI commands directly inside post_sync_root_cli()
# Example: "./setup_vendor.sh" or "git status -s"
REPO_POST_SYNC_ROOT_COMMAND=""

# 2. Full project rebuild command executed in ANDROID_TOP (AFTER entering android/qssi)
# Leave empty ("") to define custom build CLI commands directly inside post_sync_cli()
# Example: "m -j16" or "./build_target.sh"
REPO_POST_SYNC_BUILD_COMMAND=""


# ------------------------------------------------------------------------------
# 4. Device Deployment & Logcat Configuration (Android / ADB)
# NOTE:
# - Device MUST run a 'userdebug' or 'eng' build image. Production 'user' builds
#   do NOT permit 'adb root' or 'adb remount'.
# - First-time remount (dynamic partitions / overlayfs) requires an automatic
#   device reboot and may take 3-5 minutes. Subsequent remounts take only 1-2s.
# ------------------------------------------------------------------------------

# Enable or disable pushing APK to connected Android device ("true" | "false")
ENABLE_ANDROID_DEPLOY="true"

# Enable or disable setting DEBUG log level on device ("true" | "false")
ENABLE_DEBUG_LOG="true"

# List of log tags to enable on device (space-separated). Defaults to current profile tags.
# Example: "CarAudioService CarZones AudioControlHal"
DEBUG_LOG_TAGS="${DEBUG_LOG_TAGS:-$DEFAULT_DEBUG_LOG_TAGS}"

# Enable capturing logcat after device reboots ("true" | "false")
ENABLE_ANDROID_LOGCAT="false"

# Filter regex for logcat. Defaults to current profile filter.
# Leave empty ("") to capture full logcat without filtering.
LOGCAT_FILTER="${LOGCAT_FILTER:-$DEFAULT_LOGCAT_FILTER}"

# Seconds to wait after boot/restart before capturing logcat, so the app has
# time to start and log. Increase if deployment_log.txt comes out empty.
LOGCAT_SETTLE_SECONDS="10"


# ------------------------------------------------------------------------------
# 4b. Global Modular Overrides (Audio, Dumpsys & Multi-CLI Pipelines)
# Centrally managed in shared files: const_audio.config, const_dumpsys.config,
# and const_multi_cli.config (located in the same directory as build_apk.sh).
#
# If this specific project requires custom overrides or extra commands,
# uncomment and customize below:
#
# [Audio Overrides]
# ADB_SHELL_AUDIO_UP="dumpsys car_service inject-key 24"
# ADB_SHELL_AUDIO_DOWN="dumpsys car_service inject-key 25"
# ADB_SHELL_AUDIO_MUTE="dumpsys car_service inject-key 164"
#
# [Dumpsys Overrides]
# ADB_SHELL_DUMP_CUSTOM="dumpsys media.camera"
#
# [Custom Multi-CLI Pipeline Groups]
# MULTI_CMD_CUSTOM_SETUP=(
#     "adb root"
#     "adb remount"
# )
# ------------------------------------------------------------------------------


# ------------------------------------------------------------------------------
# 5. Unit Test Configuration (used when running with --test-mode true)
# ------------------------------------------------------------------------------

# Test directory path relative to this script's directory
TEST_RELATIVE_PATH="tests"

# Test runner script located inside TEST_RELATIVE_PATH
TEST_BUILD_SCRIPT="run_unittest_test.sh"


# ------------------------------------------------------------------------------
# 6. QNX Hypervisor / Target Environment Configuration (Reserved for future use)
# Used when TARGET_PLATFORM="qnx" (placeholder config, not executed yet)
# ------------------------------------------------------------------------------

# Enable or disable deploying to QNX target environment ("true" | "false")
ENABLE_QNX_DEPLOY="false"

# Enable or disable capturing slog2 logs on QNX target ("true" | "false")
ENABLE_QNX_LOG="false"

# QNX Target Hostname or IP address (e.g. "192.168.1.100" or "qnx-target.local")
QNX_HOST_IP="192.168.1.100"

# SSH / SCP port for QNX target connection (default: 22)
QNX_SSH_PORT="22"

# Destination directory path on QNX target filesystem
QNX_TARGET_DIR="/var/opt/apps"


