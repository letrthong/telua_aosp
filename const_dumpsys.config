# const_dumpsys.config - Global Dumpsys & Diagnostics Commands Configuration
# Antigravity / telua AOSP & Automotive Toolkit
# ==============================================================================
# File nay dat co dinh cung thu muc voi 'build_apk.sh' (Master Toolkit).
# Cac lenh dumpsys chan doan duoc chia se cho tat ca cac workspace/du an.
# (Neu mot du an cu the can override, khai bao lai trong apk.config)
#
# Usage: telua dump <target>   (vd: telua dump audio | telua dump car_service)
# Tat ca cac lenh duoc thuc thi truc tiep tren thiet bi qua 'adb shell <COMMAND>'.
# Compatible with standard Android and Android Automotive (CarShellCommand):
# https://cs.android.com/android/platform/superproject/+/android-latest-release:packages/services/Car/service/src/com/android/car/CarShellCommand.java
# ==============================================================================

# Dump targets (read by: telua dump <target> | telua --dump <target>)
# Options:
#   - Standard Android:        "dumpsys audio"
#   - CarService (AAOS):       "dumpsys car_service"
#   - CarAudioService (AAOS):  "dumpsys car_audio"
ADB_SHELL_DUMP_AUDIO="dumpsys audio"
ADB_SHELL_DUMP_CAR_SERVICE="dumpsys car_service"
ADB_SHELL_DUMP_CAR_AUDIO="dumpsys car_audio"
ADB_SHELL_DUMP_MEDIA_SESSION="dumpsys media_session"
ADB_SHELL_DUMP_BATTERY="dumpsys battery"
ADB_SHELL_DUMP_ACTIVITY="dumpsys activity top"

# ------------------------------------------------------------------------------
# Dump CLI Command List (Hien thi danh sach khi go: telua dump)
# Cu phap moi dong: "action :: mo ta :: cau_lenh_adb"
# Them hoac bot cac dong trong mang nay de ho tro cac lenh CLI theo nhu cau he thong:
# ------------------------------------------------------------------------------
DUMP_CLI_LIST=(
    "audio        :: Audio service state (standard)         :: $ADB_SHELL_DUMP_AUDIO"
    "car-service  :: CarService state (AAOS shell command)  :: $ADB_SHELL_DUMP_CAR_SERVICE"
    "car-audio    :: CarAudioService dumpsys (AAOS)         :: $ADB_SHELL_DUMP_CAR_AUDIO"
    "media        :: Media session state                    :: $ADB_SHELL_DUMP_MEDIA_SESSION"
    "battery      :: Battery state                          :: $ADB_SHELL_DUMP_BATTERY"
    "activity     :: Activity stack (top)                   :: $ADB_SHELL_DUMP_ACTIVITY"
)
