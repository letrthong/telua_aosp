# ==============================================================================
# apk_overlays.config.example - Personal / site overrides applied by 'telua init'
# ==============================================================================
# 'telua init' copies this file to 'apk_overlays.config' if it does not exist yet.
# apk_overlays.config is git-ignored and backed up/restored by 'telua update'.
#
# After 'telua init' copies or decrypts apk.config, each KEY=value below is applied:
#   - Top-level keys in apk.config are replaced in place.
#   - Keys not found at top level (e.g. MODULE_NAME from the case block) are
#     appended at the end of apk.config, so they win when it is sourced.
#
# Put ONLY the keys you want to change. Do NOT copy the 'case ... esac' block:
# indented keys inside it are appended flat and would override every profile.
#
# Everything is commented out, so a freshly copied file changes nothing.
# Test without writing: python3 config_overlay.py ./apk.config --dry-run
# ==============================================================================

ACTIVE_PROJECT="oem_service"
case "$ACTIVE_PROJECT" in
    "oem_service")
        MODULE_NAME="OemService"
        SOURCE_CODE_RELATIVE_PATH="packages/apps/Car/OemService"
        APK_OUTPUT_RELATIVE_PATH="out/target/product/qssi/system/priv-app/OemService"
        APK_FILE_NAME="OemService.apk"
        APK_DEPLOY_PATH="/system/priv-app/OemService"
        DEFAULT_LOGCAT_FILTER="OemService"
        DEFAULT_DEBUG_LOG_TAGS="OemService"
        ;;

     
esac

